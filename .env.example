# Public marketing site needs no auth.
# Neon + Resend for /reservar; JWT admin for /admin.

# Neon Postgres (required for booking + admin)
NEON_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend (booking confirmation emails)
RESEND_API_KEY="re_..."
RESEND_FROM="Bellas Cejas <onboarding@resend.dev>"

# Admin JWT auth (required for /admin)
AUTH_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# App Site Config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
